# deploy. The map reads the stands from forest-lac-bailey.pmtiles.
app/public/data/areas/lac-bailey/watercourse-lac-bailey.geojson
app/public/data/areas/lac-bailey/wetland-lac-bailey.geojson
app/public/data/areas/lac-bailey/forest-lac-bailey.geojson
# the hunting zones state no licence, so never ship (qc_vectors.py keeps a copy in pipeline/raw)
app/public/data/areas/lac-bailey/wmu-lac-bailey.geojson
