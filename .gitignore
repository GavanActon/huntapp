node_modules/
dist/
dist-dev/
dev-dist/
__pycache__/
pipeline/raw/
pipeline/tools/
# the far band (pipeline/far_imagery.py) lives on R2 under data/far/; a copy here is for a dev server only
app/public/data/far/
*.log
# Raw CHS NONNA bathymetry (login-gated download, non-navigational license — keep out of the public repo)
external/

# dev-only Open-Meteo response cache
app/.om-cache/

# wrangler dev state (local D1) and local secrets
worker/.wrangler/
worker/.dev.vars
site/.wrangler/

# session screenshots and vite cache
shot-*.png
.vite/

# Lac Bailey's bake inputs, which the app never reads (they are not in
# app/src/areas/lac-bailey.json's files lists): out of git, so out of the
# deploy. The map reads the stands from forest-lac-bailey.pmtiles.
app/public/data/areas/lac-bailey/watercourse-lac-bailey.geojson
app/public/data/areas/lac-bailey/wetland-lac-bailey.geojson
app/public/data/areas/lac-bailey/forest-lac-bailey.geojson
# the hunting zones state no licence, so never ship (qc_vectors.py keeps a copy in pipeline/raw)
app/public/data/areas/lac-bailey/wmu-lac-bailey.geojson
# the Sault test area's bake inputs, which the app never reads (not in
# app/src/areas/sault-test.json's files lists): the map reads the stands
# from forest-sault-test.pmtiles
app/public/data/areas/sault-test/forest-sault-test.geojson
app/public/data/areas/sault-test/watercourse-sault-test.geojson
app/public/data/areas/sault-test/wetland-sault-test.geojson
app/public/data/areas/sault-test/ara-sault-test.geojson
app/public/data/areas/sault-test/bathy_index-sault-test.geojson
app/public/data/areas/sault-test/bma-sault-test.geojson
app/public/data/areas/sault-test/fishing_access-sault-test.geojson
app/public/data/areas/sault-test/fmz-sault-test.geojson
app/public/data/areas/sault-test/rail-sault-test.geojson
app/public/data/areas/sault-test/trails-sault-test.geojson
app/public/data/areas/sault-test/trapline-sault-test.geojson
# Highland Lake's bake inputs, which the app never reads
app/public/data/areas/highland-lake/forest-highland-lake.geojson
app/public/data/areas/highland-lake/watercourse-highland-lake.geojson
app/public/data/areas/highland-lake/wetland-highland-lake.geojson

# PALM run inputs and outputs (gigabytes; the share holds the runs, fields/ holds the reads)
pipeline/teacher/palm/*/JOBS/
pipeline/teacher/palm/*/viz/

# Luther (MI): the bake's inputs the app never reads (not in luther.json's files lists)
app/public/data/areas/luther/wetland-luther.geojson
app/public/data/areas/luther/watercourse-luther.geojson
app/public/data/areas/luther/forest-luther.geojson
