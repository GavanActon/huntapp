! searchmont_stable_nest: PALM searchmont, stable, wind from 152 deg true (149.85 on the UTM grid),
! 16.2 km/h at 30 m over the lowest ground. Built by pipeline/teacher/palm/build_case.py.
! the case: does stable air under the same SSE wind reverse the floor?
&nesting_parameters
    domain_layouts = 'root',  1, -1, 8, 0.0, 0.0, 0.0,
                     'core',  2,  1, 16, 1060, 1060, 0.0,
    nesting_mode = 'one-way',             ! the root sets the core's boundaries; nothing fed back over the terrain
/

&initialization_parameters
    nx = 255, ny = 255, nz = 48,
    dx = 20, dy = 20, dz = 20, 80,
    dz_stretch_level_start = 520,
    dz_stretch_level_end = 1320,
    topography = 'read_from_file',
    initializing_actions = 'set_constant_profiles',
    bc_lr = 'cyclic', bc_ns = 'cyclic',
    omega = 0.0,                          ! no Coriolis, as WindNinja; the grid's rotation does not matter then
    uv_heights = 0, 10, 30, 60, 100, 200, 300, 500, 3000,
    u_profile  = -0, -1.578, -2.26, -2.706, -3.038, -3.491, -3.757, -4.092, -4.092,
    v_profile  = 0, 2.717, 3.891, 4.658, 5.229, 6.009, 6.467, 7.044, 7.044,
    roughness_length = 0.1,               ! where the driver's z0 has no value
    conserve_volume_flow = .T.,
    conserve_volume_flow_mode = 'initial_profiles',
    rayleigh_damping_height = 1420,
    rayleigh_damping_factor = 0.01,
    psolver = 'poisfft',
    fft_method = 'fftw',
    neutral = .F.,
    pt_surface = 291.8,
    pt_vertical_gradient = 2, 0.5,
    pt_vertical_gradient_level = 0, 300,
    bc_pt_b = 'dirichlet',
    pt_surface_heating_rate = -1,   ! K/h: the ground's temperature falls; the flux follows the turbulence
/

&runtime_parameters
    end_time = 9000,
    create_disturbances = .T.,
    dt_disturb = 150.0,
    disturbance_energy_limit = 0.01,
    dt_run_control = 60.0,
    netcdf_data_format = 2,
    interpolate_to_grid_center = .T.,     ! u, v, w on the cell centres: the DEM's lattice

    ! the field the teacher gives: the mean over the last stretch, near the ground
    data_output = 'u_av', 'v_av', 'w_av', 'e_av', 'theta_av',
    nz_do3d = 17,
    averaging_interval = 1800,
    dt_data_output_av = 1800,
    skip_time_data_output_av = 7200,
    dt_averaging_input = 10.0,

    ! gusts and lulls: the lowest four levels over the ground, every 30 s over the same stretch
    data_output_masks(1,:) = 'u', 'v', 'w',
    mask_k_over_surface(1,:) = 1, 2, 3, 4,
    dt_domask(1) = 30.0,
    skip_time_domask(1) = 7200,

    data_output_pr = '#u', '#v', 'w', 'e', 'w"u"', 'w"v"', '#theta', 'w"theta"',
    dt_dopr = 600.0,
    averaging_interval_pr = 600.0,
    dt_dots = 60.0,
/

&plant_canopy_parameters
    canopy_mode = 'read_from_file',
    canopy_drag_coeff = 0.2,
    cthf = -0.02,                    ! K m/s at the canopy top (the code's unit; the docs say W/m2)
/
