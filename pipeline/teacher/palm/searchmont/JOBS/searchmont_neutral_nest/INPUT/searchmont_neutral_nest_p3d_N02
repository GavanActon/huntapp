! searchmont_neutral_nest (nested child, N02): PALM searchmont, neutral, wind from 152 deg true (149.85 on the UTM grid),
! 16.2 km/h at 30 m over the lowest ground. Built by pipeline/teacher/palm/build_case.py.
! control: the same wind with no stratification; WindNinja's physics with resolved turbulence and canopy
&initialization_parameters
    nx = 299, ny = 299, nz = 48,
    dx = 10, dy = 10, dz = 10,
    topography = 'read_from_file',
    initializing_actions = 'set_constant_profiles',
    omega = 0.0,                          ! no Coriolis, as WindNinja; the grid's rotation does not matter then
    uv_heights = 0, 10, 30, 60, 100, 200, 300, 500, 3000,
    u_profile  = -0, -1.578, -2.26, -2.706, -3.038, -3.491, -3.757, -4.092, -4.092,
    v_profile  = 0, 2.717, 3.891, 4.658, 5.229, 6.009, 6.467, 7.044, 7.044,
    roughness_length = 0.1,               ! where the driver's z0 has no value
    psolver = 'multigrid',
    cycle_mg = 'w',
    mg_cycles = -1,                       ! iterate to residual_limit: 2 cycles left divergence over the terrain and jets at the edge
    neutral = .T.,
/

&runtime_parameters
    end_time = 10800,
    npex = 4, npey = 4,
    create_disturbances = .T.,
    dt_disturb = 150.0,
    disturbance_energy_limit = 0.01,
    dt_run_control = 60.0,
    netcdf_data_format = 2,
    interpolate_to_grid_center = .T.,     ! u, v, w on the cell centres: the DEM's lattice

    ! the field the teacher gives: the mean over the last stretch, near the ground
    data_output = 'u_av', 'v_av', 'w_av', 'e_av',
    nz_do3d = 30,
    averaging_interval = 3600,
    dt_data_output_av = 3600,
    skip_time_data_output_av = 7200,
    dt_averaging_input = 10.0,

    ! gusts and lulls: the lowest four levels over the ground, every 30 s over the same stretch
    data_output_masks(1,:) = 'u', 'v', 'w',
    mask_k_over_surface(1,:) = 1, 2, 3, 4,
    dt_domask(1) = 30.0,
    skip_time_domask(1) = 7200,

    data_output_pr = '#u', '#v', 'w', 'e', 'w"u"', 'w"v"',
    dt_dopr = 600.0,
    averaging_interval_pr = 600.0,
    dt_dots = 60.0,
/

&plant_canopy_parameters
    canopy_mode = 'read_from_file',
    canopy_drag_coeff = 0.2,
/
